# Arena Live OS — Windows / sunucu ortamı
# PostgreSQL bağlantısı (kurulum sihirbazı otomatik oluşturur)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
PORT=3000

# Yerel agent / ingest koruması (önerilir). Tanımlıysa ingest, roster ve radar
# senkron uçları bu token'ı ister. Boşsa bu uçlar yalnızca yerel ağdan (loopback)
# çağrılabilir; LAN/uzak panel kullanıyorsan mutlaka bir token tanımla.
ARENA_INGEST_TOKEN=degistir-beni

# Otomatik keşif varsayılan olarak açıktır; kapatmak için false yapın
ARENA_AUTO_SCAN=true

# Ücretli EulerStream bölge feed'i varsayılan olarak KAPALIDIR.
# Açmak için sunucuda bilinçli opt-in gerekir:
# ARENA_ENABLE_EULER_FEED=1
# EULER_API_KEY=
# Anahtarlı imzalama da ayrı opt-in ister:
# ARENA_ENABLE_KEYED_SIGNING=1

# GitHub güncelleme ve radar verisi kaynağı
ARENA_GITHUB_REPO=CehennemGibiyim/ArenaSag

# Eşzamanlı oda dinleme tavanı (varsayılan 48). Başlatma bütçesi dakikada 8,
# saatte 180, günde 900 bağlantıdır; aşılırsa yeni oda sıraya alınır.
# ARENA_LISTENER_CEILING=48

# Radar WebSocket zarf dinleyicisi (sandık/mektup yalnızca canlı akışta görünür)
# ARENA_ENVELOPE_ROOMS=60
# ARENA_ENVELOPE_SECONDS=300
# ARENA_ENVELOPE_CONCURRENCY=16
